{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/create-checkout-session.js": {
      "memory": 512,
      "maxDuration": 10
    },
    "api/send-bulk-show-email.js": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/webhook",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
