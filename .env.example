# ============================================================
# Vitalqua — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Stripe Keys ---
# Get these from https://dashboard.stripe.com/apikeys
# Use sk_test_* / pk_test_* for development
# Use sk_live_* / pk_live_* for production

STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# --- Server ---
PORT=3000

# Comma-separated list of allowed origins for CORS
# In production, set to your actual domain (e.g. https://vitalqua.org)
ALLOWED_ORIGINS=http://localhost:3000

# --- URLs ---
# Where Stripe redirects after payment confirmation
# Must be an absolute URL accessible from the user's browser
SUCCESS_URL=http://localhost:3000/success-show.html
